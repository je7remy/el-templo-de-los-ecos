[ext_resource type="Script" path="res://scripts/datos/piso.gd" id="1_piso"]

[resource]
script = ExtResource("1_piso")
numero = "VII"
titulo = "LA QUE NO APARTA LA VISTA"
estado = "ALGO TE MIRA SIN PARPADEAR"
desgaste = 1.9
eco = "serena"
seguidores = true
verdad = "Ella no caza: vigila. Quieren que veas morir a los demás; el miedo ajeno también alimenta."
inspiracion = "Inspiración: la sala de la mirada; mueren quienes gritan o se adelantan."
